{
  "name": "@routogram/client",
  "version": "0.1.0",
  "private": false,
  "description": "Development-only runtime telemetry bridge for Routogram.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@routogram/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
