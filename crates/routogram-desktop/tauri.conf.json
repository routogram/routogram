{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Routogram",
  "version": "0.1.0",
  "identifier": "dev.routogram.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @routogram/canvas dev",
    "devUrl": "http://127.0.0.1:6060",
    "beforeBuildCommand": "pnpm build:canvas",
    "frontendDist": "../../packages/canvas/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Routogram — Architecture Intelligence",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0e0e12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/daemon"]
  }
}
