---
import { BannerElement } from "../components/lit/banner-element";
import CartDrawer from "../components/react/cart-drawer";
import QuickFilter from "../components/solid/quick-filter";
import ToastNotification from "../components/svelte/toast-notification.svelte";
import ProductSpecs from "../components/vue/product-specs.vue";
import MainLayout from "../layouts/main-layout.astro";
---

<MainLayout>
  <section class="grid items-end gap-8 py-10 lg:grid-cols-[1.3fr_0.7fr]">
    <div>
      <p class="mb-4 font-mono text-[10px] uppercase tracking-[0.24em] text-cyan-300">
        Astro Islands · Multi-framework monolith
      </p>
      <h1 class="max-w-3xl text-4xl leading-[1.05] font-semibold tracking-tight text-zinc-100 sm:text-6xl">
        A workstation that keeps up with your imagination.
      </h1>
      <p class="mt-5 max-w-xl text-sm leading-6 text-zinc-400">
        One storefront, five UI runtimes. React handles the cart, Vue the specification tabs,
        Svelte the notifications, Solid the filters, and Lit the campaign banner.
      </p>
    </div>
    <div class="flex justify-start lg:justify-end">
      <CartDrawer client:load />
    </div>
  </section>

  <div class="mb-10">
    <BannerElement client:visible />
  </div>

  <section id="configure" class="grid gap-4 md:grid-cols-2">
    <QuickFilter client:load />
    <div id="specs">
      <ProductSpecs client:visible />
    </div>
  </section>

  <section id="support" class="mt-10 grid gap-4 sm:grid-cols-3">
    <article class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
      <p class="font-mono text-[9px] uppercase tracking-wider text-zinc-600">01</p>
      <h2 class="mt-2 text-xs font-semibold text-zinc-200">Configure</h2>
      <p class="mt-1 text-[10px] leading-5 text-zinc-500">
        Pick your GPU, memory, and cooling profile.
      </p>
    </article>
    <article class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
      <p class="font-mono text-[9px] uppercase tracking-wider text-zinc-600">02</p>
      <h2 class="mt-2 text-xs font-semibold text-zinc-200">Validate</h2>
      <p class="mt-1 text-[10px] leading-5 text-zinc-500">
        Compatibility checks run before checkout.
      </p>
    </article>
    <article class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
      <p class="font-mono text-[9px] uppercase tracking-wider text-zinc-600">03</p>
      <h2 class="mt-2 text-xs font-semibold text-zinc-200">Build</h2>
      <p class="mt-1 text-[10px] leading-5 text-zinc-500">
        Hand-assembled, stress-tested, and shipped insured.
      </p>
    </article>
  </section>

  <ToastNotification client:idle />
</MainLayout>
