---
import "../styles/global.css";

type Props = {
  title?: string;
};

const { title = "Nova PC — Custom Workstations" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Nova PC — custom high-performance workstations." />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased">
    <header class="border-b border-white/10">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
        <a href="/" class="flex items-center gap-3">
          <span
            class="grid size-8 place-items-center rounded-lg border border-cyan-400/30 bg-cyan-400/10 font-mono text-sm font-bold text-cyan-300"
          >
            N
          </span>
          <span class="text-sm font-semibold tracking-[0.18em] text-zinc-100 uppercase">
            Nova PC
          </span>
        </a>
        <nav class="flex items-center gap-6 text-xs text-zinc-400">
          <a class="transition-colors hover:text-zinc-100" href="#configure">Configure</a>
          <a class="transition-colors hover:text-zinc-100" href="#specs">Specs</a>
          <a class="transition-colors hover:text-zinc-100" href="#support">Support</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-12">
      <slot />
    </main>

    <footer class="mx-auto mt-16 max-w-6xl border-t border-white/10 px-6 py-8 text-[11px] text-zinc-600">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span>© {new Date().getFullYear()} Nova PC. Built with Astro Islands.</span>
        <span class="font-mono">React · Vue · Svelte · Solid · Lit</span>
      </div>
    </footer>
  </body>
</html>
